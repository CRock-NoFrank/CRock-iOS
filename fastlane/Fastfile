require 'dotenv'

# 로컬에서는 .env.dev 로드, CI(GitHub Actions 등)에서는 GitHub Secrets(ENV)만 사용
Dotenv.load('.env.dev') unless ENV['CI']

default_platform(:ios)

platform :ios do
  desc "PR 검증용 단위 테스트 실행 (시뮬레이터, 서명 불필요)"
  lane :tests do
    setup_ci if is_ci

    # 시뮬레이터 이름은 워크플로우에서 TEST_SIMULATOR로 주입. 없으면 iPhone 17로 폴백.
    device = (ENV["TEST_SIMULATOR"].to_s.strip.empty? ? "iPhone 17" : ENV["TEST_SIMULATOR"].strip)

    run_tests(
      project: "T8-NoFrank.xcodeproj",
      scheme: "T8-NoFrank",
      devices: [device],
      clean: true,
      code_coverage: false,
      # 시뮬레이터 테스트는 서명 불필요 → 서명 시도 자체를 끔
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  lane :beta do
    setup_ci if is_ci

    # App Store Connect API Key가 있으면 그걸로 인증(권장)
    UI.user_error!("Missing App Store Connect API key envs") unless ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] && ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] && ENV["APP_STORE_CONNECT_API_KEY_KEY"]

    api_key = nil
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] && ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] && ENV["APP_STORE_CONNECT_API_KEY_KEY"]
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].strip,
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"].strip,
        key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"].gsub("\\n", "\n").strip,
        is_key_content_base64: false
      )
    end

    match(
      type: "appstore",
      readonly: true
    )

    ci_build_number = ENV["CI_RUN_NUMBER"].to_s.strip
    new_build_number = if ci_build_number.empty?
      increment_build_number(
        xcodeproj: "T8-NoFrank.xcodeproj"
      )
    else
      increment_build_number(
        xcodeproj: "T8-NoFrank.xcodeproj",
        build_number: ci_build_number
      )
    end
    set_info_plist_value(path: "CRockWidget/Info.plist", key: "CFBundleVersion", value: new_build_number.to_s)

    build_app(
      scheme: "T8-NoFrank",
      configuration: "Release",
      export_method: "app-store"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Install development certs & profiles (readonly)"
  lane :setup_dev_certs do
    match(
      type: "development",
      readonly: true
    )
  end

  desc "ADMIN ONLY: sync profiles for newly added devices"
  lane :sync_profiles do
    match(
      type: "development",
      readonly: false,
      force_for_new_devices: true
    )
  end

  desc "ADMIN ONLY: add a single device then sync profiles"
  lane :add_device do |options|
    name = options[:name]
    udid = options[:udid]

    UI.user_error!("Usage: fastlane ios add_device name:\"...\" udid:\"...\"") if name.to_s.empty? || udid.to_s.empty?

    # Dev Portal에 기기 등록
    device_name = name
    device_udid = udid

    # fastlane action: register_device (단일 기기)
    register_device(
      name: device_name,
      udid: device_udid
    )

    # 새 기기 포함해서 프로비저닝 갱신
    match(
      type: "development",
      readonly: false,
      force_for_new_devices: true
    )
  end
end
