require 'dotenv'

fastlane_dir = (defined?(FastlaneCore::FastlaneFolder) && FastlaneCore::FastlaneFolder.path) || File.join(Dir.pwd, 'fastlane')
env_path = File.expand_path('../.env.dev', fastlane_dir)
Dotenv.overload(env_path) if File.exist?(env_path)

app_identifier(ENV.fetch('APP_IDENTIFIER', 'com.CRock.T8-NoFrank'))
apple_id(ENV.fetch('APPLE_ID'))
team_id(ENV.fetch('APPLE_TEAM_ID'))
